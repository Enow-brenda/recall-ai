# Neon Postgres — connection string from neon.tech
# Prefer the DIRECT "Primary" host (no "-pooler"): psycopg3 has an intermittent
# "received 2 results from ROLLBACK" glitch through Neon's pooled endpoint.
#   postgresql+psycopg://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API key — https://aistudio.google.com/apikey
# Still required: embeddings always use Gemini (DeepSeek has no embeddings API)
GEMINI_API_KEY=

# OpenRouter generation — https://openrouter.ai/keys (register with email, no
# card required). Free :free model variants / openrouter/free router cost $0 but
# are rate-limited (~50 requests/day). Embeddings still need Gemini. Leave the
# key empty to keep generation on Gemini.
# LLM_PROVIDER: auto (OpenRouter only if key set) | gemini | openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
LLM_PROVIDER=auto

# Semantic-search relevance gate — hits with cosine similarity below this are
# treated as non-matches (no "Sources" chips for weak matches). Lower = more
# permissive; raise if unrelated emails keep surfacing.
SEARCH_MIN_SIMILARITY=0.30

# Google Cloud OAuth client — console.cloud.google.com (Gmail + Calendar APIs enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session signing secret — generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env

# Cookies: dev stays SameSite=Lax / non-secure. In production set
# ENVIRONMENT=production so the session cookie becomes SameSite=None; Secure —
# without it the browser drops the cookie on cross-site API calls (frontend on
# Netlify, API on Render = different sites -> 401 "unauthorized" after login).
# Force instead with AUTH_COOKIE_SECURE=true / AUTH_COOKIE_SAMESITE=none.
ENVIRONMENT=dev
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=

# Support email delivery (POST /support) — Gmail SMTP with an app password
# (Google account needs 2-Step Verification + an App Password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SUPPORT_RECIPIENT=

# Where Google OAuth returns after sign-in (dev: Vite app, prod: Netlify)
APP_ORIGIN=http://localhost:5173/auth/callback
