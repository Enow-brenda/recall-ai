# Neon Postgres — pooled connection string from neon.tech (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud OAuth client — console.cloud.google.com (Gmail + Calendar APIs enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session signing secret — generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env

# Support email delivery (POST /support) — Gmail SMTP with an app password
# (Google account needs 2-Step Verification + an App Password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SUPPORT_RECIPIENT=

# Where Google OAuth returns after sign-in (dev: Vite app, prod: Netlify)
APP_ORIGIN=http://localhost:5173/auth/callback
